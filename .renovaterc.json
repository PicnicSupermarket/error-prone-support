{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "commitMessagePrefix": "",
  "extends": [
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^integration-tests/[^/]+(-init\\.patch|\\.sh)$/"
      ],
      "matchStrings": [
        "\\b(?<packageName>[a-z0-9_.-]+?:[a-z0-9_.-]+?):(?<currentValue>[^:]+?):[a-zA-Z0-9_-]+\\b",
        "<version>(?<currentValue>.*?)<!-- Renovate: (?<packageName>.*?) --></version>"
      ],
      "datasourceTemplate": "maven"
    },
    {
      "description": "Identifies GitHub-hosted runners missed by the `github-actions` manager, such as matrix values and documentation.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/instructions/github-actions\\.instructions\\.md$/",
        "/^\\.github/workflows/[^/]+\\.yml$/"
      ],
      "matchStrings": [
        "\\b(?<depName>macos|ubuntu|windows)-(?<currentValue>\\d+(?:\\.\\d+)?)\\b"
      ],
      "datasourceTemplate": "github-runners"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^org\\.springframework:spring-framework-bom$/",
        "/^org\\.springframework\\.boot:spring-boot[a-z-]*$/"
      ],
      "separateMinorPatch": true
    },
    {
      "matchPackageNames": [
        "github/codeql-action",
        "ruby/setup-ruby"
      ],
      "schedule": "every 4 weeks on Monday"
    }
  ],
  "reviewers": [
    "team:error-prone-support-guardians",
    "mohamedsamehsalah"
  ]
}
