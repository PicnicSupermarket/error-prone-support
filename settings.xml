<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <profiles>
        <profile>
            <!-- The build defines an optional `error-prone-fork` profile using
            which the code is built against a Picnic-managed fork of Error
            Prone. This fork is hosted using GitHub Packages. See
            https://github.com/PicnicSupermarket/error-prone/packages. -->
            <id>error-prone-fork</id>
            <repositories>
                <repository>
                    <id>error-prone-fork</id>
                    <url>https://maven.pkg.github.com/PicnicSupermarket/error-prone</url>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <servers>
        <server>
            <!-- The credentials are used to deploy snapshots to the Central
            Portal, which differs in origin from the default `central`
            repository. Maven 3.10+ only uses server credentials for the
            origins declared here or for the repositories declared using the
            same ID. -->
            <id>central</id>
            <username>${env.MAVEN_CENTRAL_USER}</username>
            <password>${env.MAVEN_CENTRAL_PASS}</password>
            <repositoryOrigins>
                <repositoryOrigin>https://central.sonatype.com</repositoryOrigin>
            </repositoryOrigins>
        </server>
        <server>
            <!-- The `error-prone-fork` profile is activated using `-P`, so
            Maven 3.10+ cannot discover the origin of its repository. -->
            <id>error-prone-fork</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
            <repositoryOrigins>
                <repositoryOrigin>https://maven.pkg.github.com</repositoryOrigin>
            </repositoryOrigins>
        </server>
    </servers>
</settings>
